{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PokéPension",
  "version": "0.43.0",
  "identifier": "fr.tennosei.pokearchive",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PokéPension",
        "width": 1100,
        "height": 800,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self' https://raw.githubusercontent.com; connect-src 'self' https://pokeapi.co https://raw.githubusercontent.com; img-src 'self' data: https://cdn.discordapp.com https://raw.githubusercontent.com https://play.pokemonshowdown.com https://s3.pokeos.com"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Tennosei5804/Pokepension/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0QzdDQkU1OUExNDI1RDMKUldUVEpSU2E1Y3ZIdEVONFJwN3dFSDczNkpSQ0Eya3hVSVZBdGh1R2U0RUZkOGdpTlNFYWNweUoK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Tennosei_",
    "copyright": "© Tennosei_",
    "category": "Utility",
    "shortDescription": "Suivi de collection Pokémon",
    "longDescription": "PokéPension suit ta progression vers un Living Dex complet, en forme normale comme en chromatique, et te permet de comparer ton avancée avec celle de tes amis.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"]
      }
    }
  }
}
